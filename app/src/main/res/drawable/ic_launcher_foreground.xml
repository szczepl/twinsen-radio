<?xml version="1.0" encoding="utf-8"?>
<!-- Maszt nadajnika z dwiema parami fal i bursztynowym punktem nadawania.
     Wszystko miesci sie w kole o promieniu 33 wokol srodka (54,54) - w tym,
     co kazdy launcher zostawia z ikony adaptacyjnej, niezaleznie od ksztaltu.
     Grubosci linii dobrane pod najmniejszy rozmiar: przy 48 px na ikone fala
     ma ~2 px i nie znika. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- fale wewnetrzne -->
    <path
        android:pathData="M63.19,42.81 A13,13 0 0,1 63.19,61.19 M44.81,42.81 A13,13 0 0,0 44.81,61.19"
        android:strokeWidth="4.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round" />

    <!-- fale zewnetrzne, lekko przygaszone - dalej od nadajnika -->
    <path
        android:pathData="M70.26,35.74 A23,23 0 0,1 70.26,68.26 M37.74,35.74 A23,23 0 0,0 37.74,68.26"
        android:strokeWidth="4.5"
        android:strokeColor="#CCFFFFFF"
        android:strokeLineCap="round" />

    <!-- maszt: dwie nogi. Bez poprzeczki - z nia w malym rozmiarze czytal sie
         jak litera "A" (sprawdzone na ekranie informacji o aplikacji). -->
    <path
        android:pathData="M54,57 L46,81 M54,57 L62,81"
        android:strokeWidth="4"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- punkt nadawania -->
    <path
        android:pathData="M54,52 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0"
        android:fillColor="#FFF2A900" />
</vector>
